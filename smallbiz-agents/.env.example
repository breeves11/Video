# Optional: enables Claude-drafted email replies / spoken phone responses
# instead of the built-in template/rule-based fallback. Get a key from
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Where the SQLite database file lives.
DATABASE_PATH=data/app.db

# Optional HTTP Basic Auth for the dashboard + API. The five Twilio webhook
# routes and the inbound-email webhook are exempt (those providers can't
# send credentials) -- each is authenticated a different way instead: see
# TWILIO_AUTH_TOKEN and INBOUND_EMAIL_SECRET below. Leave both blank for no
# auth (fine for local dev). Set BOTH before deploying somewhere with a
# public URL -- these agents can send email/SMS on the business's behalf.
# Setting only one leaves auth off with no visible error, so the app logs a
# startup warning and /api/health reports it as auth_misconfigured.
APP_USERNAME=
APP_PASSWORD=

# Per-IP requests/minute on endpoints that call paid APIs or send messages.
RATE_LIMIT_PER_MINUTE=20

# --- Outbound email (SMTP) --------------------------------------------
# Needed to actually send replies. Most providers (Gmail, Outlook, etc.)
# need an app-specific password, not your normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# Shared secret required on the inbound-email webhook (POST
# /api/emails/inbound) once set -- configure your email provider's
# inbound-parse webhook to send it as an `X-Inbound-Secret` header. REQUIRED
# before pointing a real provider at this endpoint on a public deploy:
# without it, anyone who finds the URL can trigger an auto-sent email to an
# arbitrary address using the business's SMTP account. Leave blank only for
# local testing via the dashboard's own "Simulate an inbound email" panel,
# which uses a separate, Basic-Auth-protected endpoint and ignores this.
INBOUND_EMAIL_SECRET=

# --- Inbound email (IMAP polling), optional -----------------------------
# Alternative to your email provider's inbound-parse webhook
# (POST /api/emails/inbound) -- fill this in if you'd rather have the app
# poll a mailbox directly. Leave blank to skip.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MINUTES=5

# --- Twilio (phone calls + SMS text-back), optional ----------------------
# Get these from https://console.twilio.com. Point your Twilio number's
# "A call comes in" webhook at <PUBLIC_BASE_URL>/api/phone/voice and its
# status callback at <PUBLIC_BASE_URL>/api/phone/status.
#
# TWILIO_AUTH_TOKEN doubles as the webhook's authentication: once set, every
# /api/phone/* request must carry a valid X-Twilio-Signature computed with
# this token, or it's rejected with 403. This is what stops anyone who
# finds the URL from faking call/SMS events on the business's account --
# make sure it's set (along with PUBLIC_BASE_URL below) before going live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public base URL of this deployment (e.g. https://yourapp.onrender.com).
# Used to (a) build the callback URLs Twilio calls back into
# (recording/transcription) and (b) reconstruct the exact URL Twilio signed
# for signature verification -- required if TWILIO_AUTH_TOKEN is set and
# the app sits behind a reverse proxy (Render, Railway, Fly, etc.), since
# the app would otherwise see plain http internally and every signature
# check would fail. Not needed for local-only testing via the dashboard's
# "Try the phone agent" panel, which doesn't go through Twilio at all.
PUBLIC_BASE_URL=

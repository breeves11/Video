# Optional: enables Claude-drafted email replies / spoken phone responses
# instead of the built-in template/rule-based fallback. Get a key from
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Where the SQLite database file lives.
DATABASE_PATH=data/app.db

# Optional HTTP Basic Auth for the dashboard + API (Twilio/inbound-email
# webhooks are always exempt, since those providers can't send credentials).
# Leave both blank for no auth (fine for local dev). Set both before
# deploying somewhere with a public URL -- these agents can send email/SMS
# on the business's behalf.
APP_USERNAME=
APP_PASSWORD=

# Per-IP requests/minute on endpoints that call paid APIs or send messages.
RATE_LIMIT_PER_MINUTE=20

# --- Outbound email (SMTP) --------------------------------------------
# Needed to actually send replies. Most providers (Gmail, Outlook, etc.)
# need an app-specific password, not your normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# --- Inbound email (IMAP polling), optional -----------------------------
# Alternative to your email provider's inbound-parse webhook
# (POST /api/emails/inbound) -- fill this in if you'd rather have the app
# poll a mailbox directly. Leave blank to skip.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_MINUTES=5

# --- Twilio (phone calls + SMS text-back), optional ----------------------
# Get these from https://console.twilio.com. Point your Twilio number's
# "A call comes in" webhook at <PUBLIC_BASE_URL>/api/phone/voice and its
# status callback at <PUBLIC_BASE_URL>/api/phone/status.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public base URL of this deployment (e.g. https://yourapp.onrender.com),
# used to build the callback URLs Twilio calls back into (recording/
# transcription). Not needed for local-only testing via the dashboard's
# "Try the phone agent" panel.
PUBLIC_BASE_URL=

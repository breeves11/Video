# Optional: enables real YouTube trend/competition data instead of the built-in
# deterministic estimator. Get a key from https://console.cloud.google.com/apis
# (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# Optional: enables Claude-generated scripts/titles/descriptions instead of the
# built-in template generator. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# How often (hours) the background job re-polls niches for fresh opportunity
# scores.
POLL_INTERVAL_HOURS=6

# Monthly revenue goal the dashboard tracks progress against.
REVENUE_GOAL_USD=5000

# Where the SQLite database file lives.
DATABASE_PATH=data/app.db

# Assumed videos published per month, used to project monthly revenue per
# niche. Override per-request via ?videos_per_month= on GET /api/niches.
ASSUMED_VIDEOS_PER_MONTH=8

# Optional HTTP Basic Auth. Leave both blank for no auth (fine for local dev).
# Set both before deploying somewhere with a public URL -- otherwise anyone
# with the link can call /api/content/generate or /api/niches/poll and run up
# your Anthropic/YouTube API usage.
APP_USERNAME=
APP_PASSWORD=

# Per-IP requests/minute allowed on content generation and niche polling.
RATE_LIMIT_PER_MINUTE=10
